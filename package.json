{
  "name": "oneshotlens-ai-curve",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "dev": "node tests/dev-server.js",
    "test": "node --test tests/*.test.cjs",
    "verify:production-source": "node scripts/verify-production-source.cjs && node --test tests/published-musings-catalog.test.cjs",
    "deploy:production": "npm run verify:production-source && netlify deploy --prod --dir .",
    "build": "node scripts/build-seo.mjs && node --test tests/published-musings-catalog.test.cjs tests/seo-foundation.test.cjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.0",
    "@netlify/functions": "^4.2.5",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "marked": "18.2.0"
  }
}
